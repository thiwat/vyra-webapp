# Runtime environment
NODE_ENV=development
PORT=4002

# Backend API gateway (server side only - the browser never calls it directly)
API_GATEWAY=http://127.0.0.1:3000/api/v1

# System credentials appended to the login request by the BFF (server side only)
SYSTEM_APP_KEY=your-app-key
SYSTEM_SECRET_KEY=your-secret-key

# Auth/theme cookie options
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
